{
  "version": 8,
  "sources": {
    "overture": {
      "type": "geojson",
      "data": "overture.geojson"
    }
  },
  "layers": [
    {
      "id": "my",
      "type": "fill",
      "source": "overture",
      "filter": ["==", ["get", "source_type"], "my"],
      "paint": {
        "fill-color": "green",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "osm",
      "type": "fill",
      "source": "overture",
      "filter": ["==", ["get", "source_type"], "osm"],
      "paint": {
        "fill-color": "blue",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "ml",
      "type": "fill",
      "source": "overture",
      "filter": ["==", ["get", "source_type"], "ml"],
      "paint": {
        "fill-color": "orange",
        "fill-opacity": 0.5
      }
    }
  ]
}