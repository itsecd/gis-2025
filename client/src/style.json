{
  "version": 8,
  "sources": {
    "overture": {
      "type": "geojson",
      "data": "./overture.geojson"
    }
  },
  "layers": [
    {
      "id": "overture-fill",
      "type": "fill",
      "source": "overture",
      "paint": {
        "fill-color": [
          "match",
          ["get", "source_type"],
          "my",
          "#22c55e",
          "osm",
          "#3b82f6",
          "ml",
          "#f97316",
          "#9ca3af"
        ],
        "fill-opacity": 0.65
      }
    },
    {
      "id": "overture-outline",
      "type": "line",
      "source": "overture",
      "paint": {
        "line-color": "#ffffff",
        "line-width": 0.6,
        "line-opacity": 0.8
      }
    }
  ]
}
