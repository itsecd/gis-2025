{
    "version": 8,
    "sources": {
        "overture": {
            "type": "geojson",
            "data": "/overture.geojson"
        }
    },
    "layers": [
        {
            "id": "overture-buildings-fill",
            "type": "fill",
            "source": "overture",
            "paint": {
                "fill-color": [
                    "match",
                    [
                        "get",
                        "source_type"
                    ],
                    "my",
                    "#2ecc71",
                    "osm",
                    "#3498db",
                    "ml",
                    "#e67e22",
                    "#95a5a6"
                ],
                "fill-opacity": 0.65
            }
        },
        {
            "id": "overture-buildings-outline",
            "type": "line",
            "source": "overture",
            "paint": {
                "line-color": "#2c3e50",
                "line-width": 1
            }
        }
    ]
}