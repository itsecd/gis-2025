{
  "version": 8,
  "name": "Overture Buildings Source Type Style",
  "sources": {
    "overture-buildings": {
      "type": "geojson",
      "data": "/data/overture.geojson"
    }
  },
  "layers": [
    {
      "id": "overture-buildings-fill",
      "type": "fill",
      "source": "overture-buildings",
      "paint": {
        "fill-color": [
          "match",
          ["get", "source_type"],
          "my", "#2ecc71",
          "osm", "#3498db",
          "ml", "#f39c12",
          "#9e9e9e"
        ],
        "fill-opacity": 0.65
      }
    },
    {
      "id": "overture-buildings-outline",
      "type": "line",
      "source": "overture-buildings",
      "paint": {
        "line-color": "#222222",
        "line-width": 0.8
      }
    }
  ]
}